use 5.034;
use strict;
use warnings;
use Test::More;
use DBI ();
use Selecto ();
use Selecto::Domain ();
use Selecto::Engine ();
use Selecto::Expression ();
use JSON::PP ();
# Public APIs required by the native MCP read lane, independent of MCP code.
my $dbh=DBI->connect('dbi:SQLite:dbname=:memory:',undef,undef,{RaiseError=>1,PrintError=>0});
$dbh->do('CREATE TABLE mcp_a_parent (id INTEGER, label TEXT, payload TEXT, tenant_id TEXT)');
$dbh->do('CREATE TABLE mcp_a_child (id INTEGER, parent_id INTEGER, label TEXT, tenant_id TEXT)');
$dbh->do(q{INSERT INTO mcp_a_parent VALUES (1,' padded ','{ "b": 2, "a": 1 }','A'),(2,'empty','{}','A')});
$dbh->do(q{INSERT INTO mcp_a_child VALUES (11,1,'first','A'),(12,1,'second','A'),(13,1,'foreign','B')});
my $domain=Selecto::Domain->parse({schema_version=>1,name=>'Synthetic API gate',source=>{source_table=>'mcp_a_parent',primary_key=>'id',tenant_field=>'tenant_id',fields=>[qw(id label payload tenant_id)],columns=>{id=>{type=>'integer'},label=>{type=>'string'},payload=>{type=>'json'},tenant_id=>{type=>'string'}},associations=>{child=>{queryable=>'child',field=>'child',owner_key=>'id',related_key=>'parent_id',cardinality=>'one'}}},schemas=>{child=>{source_table=>'mcp_a_child',primary_key=>'id',tenant_field=>'tenant_id',fields=>[qw(id parent_id label tenant_id)],columns=>{id=>{type=>'integer'},parent_id=>{type=>'integer'},label=>{type=>'string'},tenant_id=>{type=>'string'}},associations=>{}}},joins=>{child=>{type=>'left'}}});
my $engine=Selecto::Engine->new(domain=>$domain,adapter=>Selecto->adapter(sqlite=>(dbh=>$dbh)))->with_scope(tenant=>'A');
my $E='Selecto::Expression';
is_deeply $engine->all($engine->query->select($E->trim('label')->as('label'))->order_by('id'))->{rows}, [['padded'],['empty']], 'trim is a governed adapter expression';
my $query=$engine->query->select('id')->where($E->structured_compare('payload','eq',{a=>1,b=>2}));
is_deeply $engine->all($query)->{rows}, [[1]], 'typed JSON comparison ignores object key order and whitespace';
my $rows=$E->related_rows('child',[{key=>'name',expression=>$E->field('child.label')}],order_by=>[['id','asc']],limit=>2)->as('children');
is_deeply [$E->field_references($E->related_rows('child',['id'],filters=>[['label','first']],order_by=>[['id','asc']],limit=>2))],
    ['child.id','child.label','child.id'], 'related_rows field inspection includes local selectors, filters and ordering';
is_deeply [$E->field_references($rows)], ['child.label','child.id'], 'related_rows expression selectors retain their canonical child paths';
my $stream=$engine->stream($engine->query->select('id',$rows)->order_by('id'),fetch_size=>1);
is $dbh->selectrow_array('PRAGMA query_only'), 1, 'SQLite stream holds read-only guard for its whole lifetime';
my $first=$stream->next;
is_deeply JSON::PP::decode_json($first->[1]), [{name=>'first'},{name=>'second'}], 'related_rows retains two rows to prove a one-cardinality violation and excludes foreign tenant';
is_deeply $stream->next, [2,'[]'], 'correlated JSON stream survives the next fetch';
$stream->close;
is $dbh->selectrow_array('PRAGMA query_only'), 0, 'SQLite early close restores host read-only state';
$dbh->do(q{UPDATE mcp_a_parent SET label='reusable' WHERE id=2});
ok $dbh->{AutoCommit}, 'stream leaves host transaction state alone';
my $legacy=eval {$engine->all($engine->query->select($E->related_collection('child',['id'])));1};
ok !$legacy, 'related_collection still refuses one relationships';
is ref($@) ? $@->code : '', 'invalid_query', 'existing collection API refusal is preserved';
my $one = $engine->stream($engine->query->select('id'));
my $two = $engine->stream($engine->query->select('id'));
$one->close;
is $dbh->selectrow_array('PRAGMA query_only'), 1, 'closing one stream preserves another stream guard';
$two->close;
is $dbh->selectrow_array('PRAGMA query_only'), 0, 'last stream restores the original state';
# A failed fetch also releases the guard before returning its safe error.
$dbh->sqlite_create_function('mcp_a_abort',1,sub { die 'synthetic failure' if $_[0]==2; $_[0] });
my $statement=Selecto::Statement->new(sql=>'SELECT mcp_a_abort(id) FROM mcp_a_parent ORDER BY id',params=>[],columns=>['id'],adapter_name=>'sqlite');
eval {my $s=$engine->adapter->stream_query($statement);$s->next while !$s->closed;1};
is $dbh->selectrow_array('PRAGMA query_only'), 0, 'failed stream restores query_only';
done_testing;
