#!/usr/bin/env perl

use 5.034;
use strict;
use warnings;
use FindBin qw($Bin);
use File::Spec::Functions qw(catdir rel2abs);

my $core = rel2abs(catdir($Bin, '..'));
my $cert = $ENV{SELECTO_LIVE_SELECTO_PERL_CERTIFICATION}
    // catdir($core, '..', 'selecto-perl-certification');
$cert = rel2abs($cert);
die "selecto-perl-certification was not found at $cert\n"
    unless -f catdir($cert, 'lib', 'Selecto', 'Certification.pm');

unshift @INC, catdir($core, 'lib'), catdir($cert, 'lib');
require Selecto::Certification;

my $ok = eval { Selecto::Certification->run(@ARGV); 1 };
if (!$ok) {
    my $error = $@;
    $error =~ s/\s+\z//;
    warn "selecto-certify: $error\n";
    exit 1;
}

__END__
=head1 NAME

selecto-certify - run the Selecto certification observation protocol

=head1 SYNOPSIS

  selecto-certify --request /path/to/request.json

  # Use a certification runner checkout that is not next to this one:
  SELECTO_LIVE_SELECTO_PERL_CERTIFICATION=/path/to/selecto-perl-certification \
      selecto-certify --request request.json

=head1 DESCRIPTION

C<selecto-certify> is a thin workspace wrapper around the observation
runner in the separate C<selecto-perl-certification> checkout. The central,
cross-language Selecto certification harness writes a request file naming a
target backend and the cases to observe, invokes this command, and compares
the observations it writes against its own expected results. The runner
exercises only public Selecto APIs.

The runner is looked up in C<../selecto-perl-certification> relative to
this distribution, or in the directory named by
C<SELECTO_LIVE_SELECTO_PERL_CERTIFICATION>; the command exits with an error
if it cannot be found. It is not needed to use Selecto in an application.

Database connection URLs come from environment variables named in the
request and are never written to output. Run it only against disposable
databases: the runner creates and removes its own fixture tables.

=head1 EXIT STATUS

0 on success; 1 with a one-line message on standard error on failure.

=head1 SEE ALSO

L<Selecto>, L<https://github.com/seeken/selecto-perl>

